{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // shadcn/ui's files are the CLI's, not ours: `npx shadcn add` writes them
      // whole, and its components export their `cva` class sets beside them
      // (`buttonVariants`; toggle-group imports `toggleVariants` from toggle).
      // Moving those out would be undone by the next `add --overwrite`. All
      // they cost is a full reload, not a fast refresh, while one is edited.
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
