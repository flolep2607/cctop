{
  "extraKnownMarketplaces": {
    "claude-issue-loop": {
      "source": {
        "source": "github",
        "repo": "flolep2607/claude-issue-loop"
      }
    }
  },
  "enabledPlugins": {
    "issue-loop@claude-issue-loop": true
  },
  "hooks": {
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(now|todate) \\(.from_model // \"?\") -> \\(.to_model // \"?\") (\\(.source // \"?\")) \\(.cwd // \"?\")\"' >> \"$HOME/.claude/model-switches.log\" 2>/dev/null || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
